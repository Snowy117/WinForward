<Project>
  <!-- MSBuild stops searching at the nearest Directory.Build.props, so the repo-root one must be
       imported explicitly; without this every project under tests/ would lose net10.0,
       TreatWarningsAsErrors, AnalysisLevel and the shared analyzer package set. -->
  <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.props" />

  <PropertyGroup>
    <!--
      The allocation gates measure GC.GetAllocatedBytesForCurrentThread() across a short loop that
      drives an allocation-free path. Tiered compilation makes that reading unsound: its machinery
      performs a one-time managed allocation on the calling thread as a hot method's code version is
      published (call counting and on-stack replacement both do it), and the window catches the lump
      when it lands inside the measured iterations (measured 2026-09-30: 12/20 and 17/20 process runs
      showed a 7,336-7,360 B jump in a loop whose only work was reading the counter, and the
      DispatcherWarmFastPath gate failed 2/20 runs with 1,880 B). With TieredCompilation=false every
      method is compiled by the optimizing JIT on first use, so no tiering event can land in a window
      and the gates measure the optimized steady state production reaches anyway.

      The setting lives here rather than on each test project because allocation measurement is
      spread across five production layers plus the performance suite, and which files measure
      allocations is not a stable property of a layer. A per-project declaration would need
      re-derivation every time a test gained an allocation assertion, and missing one leaves a
      flaky gate whose failure looks like a product regression.
    -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
</Project>
