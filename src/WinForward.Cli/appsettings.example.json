{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "WinForward": {
    "ProxyUnavailableAction": "block",
    "ProcessingFailureAction": "block",
    "TcpFlowCapacity": 4096,
    "SetupWorkerCount": null,
    "UdpSessionCapacity": null,
    "UdpRelayReceiveBufferKb": 64,
    "UdpSessionIdleSeconds": 30,
    "Socks5Servers": [
      {
        "Name": "main",
        "Host": "127.0.0.1",
        "Port": 1080,
        "Username": "user",
        "Password": "secret",
        "UdpOverTcp": false
      }
    ],
    "LocalTargets": [ { "Name": "dns-hijack", "Host": "127.0.0.1", "Port": 53 } ],
    "Host": {
      "FallbackAction": "pass",
      "Rules": [
        { "Protocol": ["udp"], "RemotePort": ["67", "68"], "Action": "pass" },
        { "RemoteCidr": ["fe80::/10"], "Action": "pass" },
        { "RemoteCidr": [ "198.18.0.0/15", "2001:2::/64" ], "Action": "proxy", "Target": "main" },
        {
          "Process": [
            "C:\\Path\\To\\TargetExe.exe",
            "D:\\Path\\To\\Folder\\",
            "Just-A-Name.exe"
          ],
          "Action": "pass"
        },
        { "RemoteCidr": [ "127.0.0.0/8", "::1/128", "192.168.77.0/24", "fd00:dead:beef::/64" ], "Action": "pass" },
        { "Protocol": ["udp"], "RemotePort": ["53"], "Action": "proxy", "Target": "dns-hijack" },
        { "Action": "proxy", "Target": "main" }
      ]
    },
    "Forwarded": {
      "FallbackAction": "pass",
      "Rules": [
        {
          "AdapterId": [ "{xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx}" ],
          "RemoteCidr": [ "192.168.77.0/24", "fd00:dead:beef::/64" ],
          "Action": "pass"
        },
        { "Protocol": ["udp"], "RemotePort": ["53"], "Action": "proxy", "Target": "dns-hijack" },
        { "AdapterId": [ "{xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx}" ], "Action": "proxy", "Target": "main" }
      ]
    }
  }
}
