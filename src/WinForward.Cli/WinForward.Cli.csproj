<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>WinForward</AssemblyName>
    <RootNamespace>WinForward.Cli</RootNamespace>
    <PublishAot>true</PublishAot>

    <!-- Do not raise this. The executable is compiled for one instruction set for its whole lifetime
         and executes illegal instructions at process start on anything older, with no runtime guard
         possible because every ISA check in the image is folded to a constant at compile time.
         base is the lowest level ilc accepts, so it adds no requirement beyond the one the .NET 10
         runtime already imposes; avx2 would add one it does not, and VMs commonly mask AVX2 behind
         an EVC baseline. Unverified for the ARM64 leg: whether arm64's `base` includes NEON, which
         is what gates the Vector<T> tier — ilc lists `neon` separately, and no ARM64 host was
         available to check; if it excludes NEON the checksum falls back to scalar there.
         The cost of staying at base is narrower vector code: the
         PacketChecksums.Sum vector path runs at 128 bits where the JIT's runs at 256 or 512
         depending on the host, measured at 3.5-4x on a 1 514-byte checksum and priced in
         benchmarks/results/2026-10-06-aot-instruction-set/; the framework-dependent artifact is
         the way around it. The valid values are the ones ilc reports in its help output; x64 is not one
         of them. -->
    <IlcInstructionSet>base</IlcInstructionSet>

    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>

    <!-- GC-off posture (task 09-18 M5). The steady-state packet/flow/connection paths allocate
         nothing on the managed heap, so the GC must never run; these settings make that intent
         explicit and fence any regression. Workstation + non-concurrent GC is the posture the
         zero-allocation contract assumes; retaining no VM lets the runtime hand a shrunk startup
         heap back to the OS. The heap hard limit below turns a runaway allocation regression into
         a fail-fast (GC-then-OOM) instead of silent, unbounded collecting growth. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- Hard managed-heap fuse in bytes (not percent, so the ceiling is deterministic). Basis:
         the gc-soak steady-state harness (mixed TCP+UDP loopback, 128 flows + 8 relays) measures a
         post-full-GC managed heap of ~12-13 MiB across runs (`managedHeapBytes`). The production
         daemon's live managed set is larger — capture composition, pre-sized flow tables,
         per-adapter and per-session state — but remains well inside this ceiling; revisit this value
         against a real hardware measurement of the daemon under representative connection load
         before treating it as final. 128 MiB (134217728) is ~10x the measured harness baseline and
         sits at the top of the design's expected 64-128 MiB order: deliberate headroom so bounded
         BCL infrastructure allocations (Socket/NetworkStream per connection, slow-path async state
         machines) stay collectible without ever tripping the fuse, while a genuine per-packet leak
         (GBs over a soak) still fails fast instead of silently growing. An explicit
         RuntimeHostConfigurationOption (rather than an MSBuild GC property, which does not exist for
         this key) guarantees the runtimeconfig.json entry in both JIT and AOT publishes. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="134217728" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WinForward.Integration.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../WinForward.Core/WinForward.Core.csproj" />
    <ProjectReference Include="../WinForward.Configuration/WinForward.Configuration.csproj" />
    <ProjectReference Include="../WinForward.Protocols/WinForward.Protocols.csproj" />
    <ProjectReference Include="../WinForward.NdisApi/WinForward.NdisApi.csproj" />
    <ProjectReference Include="../WinForward.Windows/WinForward.Windows.csproj" />
    <ProjectReference Include="../WinForward.Runtime/WinForward.Runtime.csproj" />
  </ItemGroup>
</Project>
