# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Don't use tabs for indentation.
[*]
indent_style = space
# (Please don't specify an indent_size here; that has too many unintended consequences.)
spelling_exclusion_path = SpellingExclusions.dic

# Code files
[*.{cs,csx,vb,vbx}]
indent_size = 4
insert_final_newline = true
charset = utf-8

# XML project files
[*.{csproj,vbproj,vcxproj,vcxproj.filters,proj,projitems,shproj}]
indent_size = 2

# XML config files
[*.{props,targets,ruleset,config,nuspec,resx,vsixmanifest,vsct}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Powershell files
[*.ps1]
indent_size = 2

# Shell script files
[*.sh]
end_of_line = lf
indent_size = 2

# Dotnet code style settings:
[*.{cs,vb}]

# Sort using and Import directives with System.* appearing first
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
# Avoid "this." and "Me." if not necessary
dotnet_style_qualification_for_field = false:refactoring
dotnet_style_qualification_for_property = false:refactoring
dotnet_style_qualification_for_method = false:refactoring
dotnet_style_qualification_for_event = false:refactoring

# Use language keywords instead of framework type names for type references
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# Suggest more modern language features when available
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_explicit_tuple_names = true:suggestion

# Whitespace options
dotnet_style_allow_multiple_blank_lines_experimental = false

# 字段命名约定（2026-09-19 用户裁定，按"声明"的可访问性匹配）：
# - public/protected（可能公开暴露，含 protected internal）→ PascalCase 无前缀；公开字段因性能允许保留，
#   命名同为 PascalCase（internal 类型上的 public 字段亦然，属预期）。
# - internal 与 private 同级：static → s_camelCase（[ThreadStatic] 的 t_ 前缀是本仓特例，
#   在 PacketRuntime 声明处用局部 pragma 标注）；实例字段 → _camelCase。
# - private/internal const → PascalCase；局部 const → camelCase（由 locals_and_parameters 规则负责）。
#
# Non-private static fields are PascalCase（non-private 现仅指 public/protected 系；internal 归 s_ 规则）
dotnet_naming_rule.non_private_static_fields_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.non_private_static_fields_should_be_pascal_case.symbols = non_private_static_fields
dotnet_naming_rule.non_private_static_fields_should_be_pascal_case.style = non_private_static_field_style

dotnet_naming_symbols.non_private_static_fields.applicable_kinds = field
dotnet_naming_symbols.non_private_static_fields.applicable_accessibilities = public, protected, protected_internal
dotnet_naming_symbols.non_private_static_fields.required_modifiers = static

dotnet_naming_style.non_private_static_field_style.capitalization = pascal_case

# Non-private readonly fields are PascalCase（同上：仅 public/protected 系）
dotnet_naming_rule.non_private_readonly_fields_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.non_private_readonly_fields_should_be_pascal_case.symbols = non_private_readonly_fields
dotnet_naming_rule.non_private_readonly_fields_should_be_pascal_case.style = non_private_readonly_field_style

dotnet_naming_symbols.non_private_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.non_private_readonly_fields.applicable_accessibilities = public, protected, protected_internal
dotnet_naming_symbols.non_private_readonly_fields.required_modifiers = readonly

dotnet_naming_style.non_private_readonly_field_style.capitalization = pascal_case

# Constants are PascalCase（private/internal const；局部 const 交给 locals 规则 → camelCase）
dotnet_naming_rule.constants_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.constants_should_be_pascal_case.symbols = constants
dotnet_naming_rule.constants_should_be_pascal_case.style = constant_style

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_style.constant_style.capitalization = pascal_case

# Static fields are camelCase and start with s_（internal 与 private 同级）
dotnet_naming_rule.static_fields_should_be_camel_case.severity = suggestion
dotnet_naming_rule.static_fields_should_be_camel_case.symbols = static_fields
dotnet_naming_rule.static_fields_should_be_camel_case.style = static_field_style

dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.applicable_accessibilities = internal, private_protected, private
dotnet_naming_symbols.static_fields.required_modifiers = static

dotnet_naming_style.static_field_style.capitalization = camel_case
dotnet_naming_style.static_field_style.required_prefix = s_

# Instance fields are camelCase and start with _（同上：internal/private 系）
dotnet_naming_rule.instance_fields_should_be_camel_case.severity = suggestion
dotnet_naming_rule.instance_fields_should_be_camel_case.symbols = instance_fields
dotnet_naming_rule.instance_fields_should_be_camel_case.style = instance_field_style

dotnet_naming_symbols.instance_fields.applicable_kinds = field
dotnet_naming_symbols.instance_fields.applicable_accessibilities = internal, private_protected, private

dotnet_naming_style.instance_field_style.capitalization = camel_case
dotnet_naming_style.instance_field_style.required_prefix = _

# Locals and parameters are camelCase
dotnet_naming_rule.locals_should_be_camel_case.severity = suggestion
dotnet_naming_rule.locals_should_be_camel_case.symbols = locals_and_parameters
dotnet_naming_rule.locals_should_be_camel_case.style = camel_case_style

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local

dotnet_naming_style.camel_case_style.capitalization = camel_case

# Local functions are PascalCase
dotnet_naming_rule.local_functions_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.local_functions_should_be_pascal_case.symbols = local_functions
dotnet_naming_rule.local_functions_should_be_pascal_case.style = local_function_style

dotnet_naming_symbols.local_functions.applicable_kinds = local_function

dotnet_naming_style.local_function_style.capitalization = pascal_case

# By default, name items with PascalCase
dotnet_naming_rule.members_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.members_should_be_pascal_case.symbols = all_members
dotnet_naming_rule.members_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.all_members.applicable_kinds = *

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# RS0016: Only enable if API files are present
dotnet_public_api_analyzer.require_api_files = true

# IDE0055: Fix formatting
# Workaround for https://github.com/dotnet/roslyn/issues/70570
dotnet_diagnostic.IDE0055.severity = warning

# 2026-09-19 独立抑制审计（结论见 .trellis/tasks/09-19-src-analyzer-cleanup/research/suppression-audit.md）：
# 实证复核本文件全部 severity = none 条目与源码 pragma（“启用实验”命中数见审计文档）。规则级抑制仅保留
# 有实证命中或面向本仓真实使用模式的条目；注释均按本仓库事实改写。审计移除的条目（0 命中且理由所指
# 模式在本仓不存在，或原理由系其它仓库的继承文本）：
# - RS1039：仅针对 Roslyn 分析器/源生成器开发代码（SemanticModel.GetDeclaredSymbol），本仓无此类工程；
# - CA1822 / RCS1197 / MA0038：0 命中；原“fixer 误修 extension 块/InterpolatedStringHandlerArgument”
#   理由在本仓不可复现（全仓 0 处 extension 块与 0 处该特性），且均为 info 级；
# - MA0009：本仓零 Regex 使用，无触发载体；
# - MA0056 / MA0015 / S4456（tests 段）：测试树零 virtual/abstract 成员、零参数异常抛出、零迭代器。
# 若未来引入上述模式并在门禁中触发诊断，按 spec 以局部 pragma + 理由（或按需重建规则级条目）处理。
# 2026-09-19 复审补记（用户指示——抑制必须按证据路径 glob 限定，不得以“当前无命中”为由全局豁免）：
# MA0041 与 IDE0130 已由全局条目改为路径限定（tests/ 与 tests/WinForward.Core.Tests/TestHelpers/），
# src 重回对应规则的正常管辖。

# RCS1146（Use conditional access）：本仓 8 处命中集中在 Policy.IsMatch 等 `x is not null && !x....`
# 守卫链（src 7 / tests 1）。刻意保留显式 null 守卫写法（守卫链短路语义最直观，`?.`/`is false`
# 变体可读性更低且需逐点重写），故降级该条规则。注：原注释将其误标为“成员可标记为 static”，
# 与 CA1822/RCS1197/MA0038 同块——两者规则无关，2026-09-19 审计拆分改写。
dotnet_diagnostic.RCS1146.severity = none

# 第三方分析器规则级抑制（2026-09-19 审计逐条实证；命中数与样本见 research/suppression-audit.md）：
#
# MA0048（File name must match type name，默认 warning）：实测 205 处命中 / 64 文件——本仓刻意的
# “一文件多类型”组织模式：src 的聚合契约/记录文件（Domain.cs、ConfigurationModels.cs、
# NdisApiAbi.cs、TcpRedirectInterfaces.cs 等）、benchmarks/BenchmarkShared.cs、
# tests/TestHelpers/TcpCoordinatorFakes.cs 等。强制拆分会破坏既有组织，属根本不兼容。
# （原注举例 AccessControlContracts.cs/EF 实体/JsonStreamEvent 均为其它仓库文本，已改。）
dotnet_diagnostic.MA0048.severity = none
#
# MA0004（Use Task.ConfigureAwait，默认 warning）：实测 99 处命中（tests 78 / benchmarks 17 / src 4）。
# 本仓是自托管控制台/服务主机（WinForward.Cli 为 Exe；无 WPF/WinForms/ASP.NET Core 引用），
# 无线程亲和 SynchronizationContext，ConfigureAwait(false) 不改变行为；仓库在链路深处自行使用
# （src 231 处），不采用 MA0004 的全面强制。（原注“运行在 ASP.NET Core host”失实，审计改写。）
dotnet_diagnostic.MA0004.severity = none
#
# VSTHRD003（Avoid awaiting foreign Tasks，默认 warning）：实测 39 处命中（tests 25 / src 10 /
# benchmarks 4）。本仓无 JoinableTaskFactory / VS 宿主，被 await 的任务均为同进程内自建
# （pump/monitor/TCS）；并发测试的“释放屏障”（TaskCompletionSource + await start.Task）是
# quality-guidelines 明确要求的刻意设计。VSTHRD003 所防的跨上下文死锁场景在本仓不存在。
# （原注的“服务端 host”说法失实，审计改写。）
dotnet_diagnostic.VSTHRD003.severity = none
#
# MA0026 / S1135（TODO 注释，默认 warning）：审计实测全仓 0 条 TODO、0 命中。保留该降级以支持
# “TODO 作为有意待办追踪”的工作流声明（配置作者既定意图；旧注用于举例的 RemoveUserAsync/数据库
# 系其它仓库文本，已删除）。若团队确认不使用 TODO 工作流，可后续移除此二条。
dotnet_diagnostic.MA0026.severity = none
dotnet_diagnostic.S1135.severity = none

# 测试树 tests/**：测试 fixture / fake / 场景与下列规则系统冲突（2026-09-19 审计逐条实证；命中数与
# 样本见 research/suppression-audit.md）。与旧注释不同，此处不再声称“仅限实测触发的规则”——部分条目
# 当前 0 命中，但其监控的构造（fixture 属性/重载/同步 I/O/阻塞调用）在测试树中被广泛使用，按 design §5
# 作为对未来测试代码的防护保留：
# - fixture/fake 为镜像真实接口保留、套件未读取的成员（S1144 实测 1 处真阳性：
#   TcpPendingSynSetupTests.CancellableGatedListenerFactory.Listeners 未被读取）；
# - 断言经异常或副作用的用例（S2699 实测 3 处，如“不抛即通过”的幂等性用例）；
# - 测试替身的重载/同名参数（S927 实测 4 处，如 lambda 参数 `_` 与接口声明名不一致）；
# - 重载分组/未赋值成员/setter 未用 value（S4136/S3459/S3237，0 命中；fixture 常见形态）；
# - 同步 API 替代 async（S6966，0 命中；测试树大量使用同步 socket/stream 调用）；
# - 场景级长方法（MA0051 实测 2 处）；同步阻塞用法（VSTHRD002 实测 4 处、VSTHRD103 0 命中；
#   测试以阻塞探测时序属刻意；src/ 不在抑制范围，仍受保护）；方法名缺 Async 后缀（VSTHRD200 实测 2 处，
#   局部函数 Resolver 返回 ValueTask 属名称即语义的测试脚手架）。
# 审计移除：MA0056（测试树零 virtual/abstract 成员）、MA0009（零 Regex 使用）、
# MA0015（零参数异常抛出；src 的刻意 member-path paramName 由局部 pragma 覆盖）、
# S4456（零迭代器方法）。
[tests/**.cs]
dotnet_diagnostic.S1144.severity = none
dotnet_diagnostic.MA0051.severity = none
dotnet_diagnostic.S927.severity = none
dotnet_diagnostic.S4144.severity = none
dotnet_diagnostic.S4136.severity = none
dotnet_diagnostic.S3459.severity = none
dotnet_diagnostic.S3237.severity = none
dotnet_diagnostic.S2699.severity = none
dotnet_diagnostic.VSTHRD002.severity = none
dotnet_diagnostic.VSTHRD103.severity = none
dotnet_diagnostic.VSTHRD200.severity = none
dotnet_diagnostic.S6966.severity = none
# MA0040（方法支持取消但未传 CancellationToken，info）：实测 30 处、全部在 tests——测试用例多数只
# 断言单一行为，刻意不串取消令牌；src/ 与 benchmarks 不在抑制范围（bench 站点已按规则修复）。
dotnet_diagnostic.MA0040.severity = none
# MA0182（Avoid unused internal types，info）：tests 实测 1 处真阳性——TcpCoordinatorFakes.BarrierListenerFactory
# 是文档完备但当前无引用的 fixture 辅助类型；测试 fixture 允许保留未接线辅助类型（info 级、不影响构建）。
# 旧注的 GameSettingsContract.Discover/UserConfigurableSettingsContract 系其它仓库文本，已删除。
dotnet_diagnostic.MA0182.severity = none
# MA0041（Make property static，已被作者弃用、继任者即 CA1822）：命中全部为测试 fixture 中读取
# primary 构造器参数的属性（加 static 必然 CS9105/CS9113，B4 实测——弃用规则的误报）。
# 按“抑制只覆盖证据所在路径”原则仅限 tests/（2026-09-19 复审）：src 出现同类命中时按局部 pragma 处置。
dotnet_diagnostic.MA0041.severity = none

# xUnit 分析器（2026-09-19 审计改写；原“迁移新 xUnit / 组件治理 / roslyn#75093”注释系其它仓库文本）：
# xUnit1030（测试方法不应调用 ConfigureAwait(false)，默认 warning）实测 94 处、xUnit1031（测试方法
# 不应使用阻塞式任务操作，默认 warning）实测 2 处——本仓测试与生产代码统一使用 ConfigureAwait(false)
# 惯例，时序探测以阻塞/TaskCompletionSource 门控实现（725 测试全绿，未观察到并行度问题）；
# 修复=删除 94 处调用，属行为可见的批量变更、收益为零。其余五条当前 0 命中，但 Assert.Same /
# Assert.True / Assert.Empty / 理论数据 null / 集合断言在测试树中广泛使用，保留作为断言退化防护
# （xUnit2023 为 info 级）。
dotnet_diagnostic.xUnit1012.severity = none
dotnet_diagnostic.xUnit1030.severity = none
dotnet_diagnostic.xUnit1031.severity = none
dotnet_diagnostic.xUnit2005.severity = none
dotnet_diagnostic.xUnit2020.severity = none
dotnet_diagnostic.xUnit2023.severity = none
dotnet_diagnostic.xUnit2029.severity = none

# IDE0130（namespace 与文件夹不匹配）：测试辅助类型刻意使用父命名空间（WinForward.Core.Tests），
# 避免每个测试文件追加 using——改为子命名空间需改 19 个辅助文件 + 全部消费方，属净 churn。
# 按“抑制只覆盖证据所在路径”原则仅限 TestHelpers 目录（2026-09-19 复审）：src 与其它 tests 目录
# 不受影响，未来若出现不匹配诊断即正常上报。原“fixer 改 MSBuild document properties 致 format 崩溃”
# 说法系其它仓库继承文本，本仓未复现（审计删除）。
[tests/WinForward.Core.Tests/TestHelpers/**.cs]
dotnet_diagnostic.IDE0130.severity = none

# CSharp code style settings:
[*.cs]
# Newline settings
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# Indentation preferences
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_switch_labels = true
csharp_indent_labels = flush_left

# Whitespace options
csharp_style_allow_embedded_statements_on_same_line_experimental = false
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = false
csharp_style_allow_blank_line_after_colon_in_constructor_initializer_experimental = false
csharp_style_allow_blank_line_after_token_in_conditional_expression_experimental = false
csharp_style_allow_blank_line_after_token_in_arrow_expression_clause_experimental = false

# Prefer "var" everywhere
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Prefer method-like constructs to have a block body
csharp_style_expression_bodied_methods = false:none
csharp_style_expression_bodied_constructors = false:none
csharp_style_expression_bodied_operators = false:none

# Prefer property-like constructs to have an expression-body
csharp_style_expression_bodied_properties = true:none
csharp_style_expression_bodied_indexers = true:none
csharp_style_expression_bodied_accessors = true:none

# Suggest more modern language features when available
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion
csharp_style_prefer_extended_property_pattern = true:suggestion

# Space preferences
csharp_space_after_cast = false
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_semicolon_in_for_statement = true
csharp_space_around_binary_operators = before_and_after
csharp_space_around_declaration_statements = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_before_comma = false
csharp_space_before_dot = false
csharp_space_before_open_square_brackets = false
csharp_space_before_semicolon_in_for_statement = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_between_square_brackets = false

# Blocks are allowed
csharp_prefer_braces = true:silent
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true

# jb/R# ArrangeTrailingCommaInMultilineLists/SinglelineLists：代码库 de facto 使用多行尾逗号
# （enums / multiline initializers / method calls），dotnet format 对尾逗号静默=允许，
# 但 jb 默认偏好"不要尾逗号"与之冲突。jb inspectcode 对风格偏好键解析不稳定，
# 故直接用 _highlighting 键禁用这两条检查，使其与代码库 de facto 风格一致。
resharper_arrange_trailing_comma_in_multiline_lists_highlighting = none
resharper_arrange_trailing_comma_in_singleline_lists_highlighting = none

# IDE0060: Remove unused parameter
dotnet_diagnostic.IDE0060.severity = warning
