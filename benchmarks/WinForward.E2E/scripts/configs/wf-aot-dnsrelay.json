{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "WinForward": {
    "Socks5Servers": [
      {
        "Name": "main",
        "Host": "127.0.0.1",
        "Port": 1080,
        "UdpOverTcp": true
      }
    ],
    "Host": {
      "FallbackAction": "pass",
      "Rules": [
        {
          "Process": [
            "sing-box.exe"
          ],
          "Action": "pass"
        },
        {
          "Process": [
            "WinForward.E2E.Direct.exe"
          ],
          "Protocol": [
            "tcp",
            "udp"
          ],
          "Action": "pass"
        },
        {
          "Process": [
            "WinForward.E2E.exe"
          ],
          "Protocol": [
            "tcp",
            "udp"
          ],
          "Action": "proxy",
          "Target": "main"
        }
      ]
    }
  }
}
