# shellcheck shell=bash
# Campaign driver configuration: variable names only.
#
# No value belongs in this file. Every machine-specific value is documented in
# benchmarks/WinForward.E2E/AGENTS.local.md (gitignored) and exported by the operator's shell before
# a driver runs. A driver refuses to run when a required name is unset or empty, and names the
# variable; a guessed address or port would make a campaign that cannot be re-derived.
#
# `:=` keeps a value exported by the caller. The exports at the end propagate the values to every
# driver a driver starts: deploy-campaign.sh invokes wf.sh as a subprocess.

# --- machines ---------------------------------------------------------------------------------
: "${WF_VM_HOST:=}"            # Windows VM address (WinRM)
: "${WF_VM_USER:=}"            # WinRM user
: "${WF_VM_PASSWORD_VAR:=}"    # name of the environment variable that holds the VM password
: "${WF_WINRM_PORT:=}"         # WinRM port on the VM
: "${WF_SESSION:=}"            # tmux session hosting the evil-winrm REPL
: "${WF_HOST_IP:=}"            # Linux host address the target binds and the VM dials

# --- local paths ------------------------------------------------------------------------------
: "${WF_SCRATCH:=}"            # local scratch root: pane capture, downloads, deploy record
: "${WF_PUB:=}"                # publish.sh output root
: "${WF_LEDGER_DIR:=}"         # where start-targets.sh writes ledger-main/direct
: "${WF_ARCHIVE_ROOT:=}"       # campaign archive root on the host
: "${WF_CAMPAIGN_ROOT:=}"      # local campaign tree downloaded by publish-campaign.sh
: "${WF_THRESHOLDS:=}"         # calibration thresholds.json (absolute, or relative to the repo root)
: "${WF_PROXIFIER_PROFILE:=}"  # local Proxifier GUI export staged for the proxifier row

# --- VM paths ---------------------------------------------------------------------------------
: "${WF_VM_ROOT:=}"            # the VM's benchmark root
: "${WF_RESULTS_ROOT:=}"       # orchestrator -OutRoot, and the campaign root publish-campaign.sh zips

# --- campaign shape ---------------------------------------------------------------------------
: "${WF_PLAN_SET:=}"           # release | canonical | windows (release stages plans-release/)
: "${WF_SEED:=}"               # orchestrator -Seed
: "${WF_ORDER_SEED:=}"         # orchestrator -OrderSeed (0 derives the order seed from WF_SEED)
: "${WF_PASSES:=}"             # orchestrator -Passes; the release runbook uses 7

# --- target ports -----------------------------------------------------------------------------
: "${WF_TCP_PORT:=}"
: "${WF_UDP_PORT:=}"
: "${WF_DNS_PORT:=}"
: "${WF_DNS_PORT_ALT:=}"
: "${WF_TCP_PORT_DIRECT:=}"
: "${WF_UDP_PORT_DIRECT:=}"
: "${WF_DNS_PORT_DIRECT:=}"
: "${WF_CLOCK_PROBE_PORT:=}"

export WF_VM_HOST WF_VM_USER WF_VM_PASSWORD_VAR WF_WINRM_PORT WF_SESSION WF_HOST_IP
export WF_SCRATCH WF_PUB WF_LEDGER_DIR WF_ARCHIVE_ROOT WF_CAMPAIGN_ROOT WF_THRESHOLDS WF_PROXIFIER_PROFILE
export WF_VM_ROOT WF_RESULTS_ROOT
export WF_PLAN_SET WF_SEED WF_ORDER_SEED WF_PASSES
export WF_TCP_PORT WF_UDP_PORT WF_DNS_PORT WF_DNS_PORT_ALT
export WF_TCP_PORT_DIRECT WF_UDP_PORT_DIRECT WF_DNS_PORT_DIRECT WF_CLOCK_PROBE_PORT
