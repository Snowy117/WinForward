{
  "socks5Servers": [
    {
      "name": "remote",
      "host": "proxy.example.com",
      "port": 1080
    }
  ],
  "host": {
    "fallbackAction": "pass",
    "rules": []
  },
  "forwarded": {
    "fallbackAction": "pass",
    "rules": [
      {
        "adapterName": ["vEthernet (MyVM)"],
        "protocol": ["tcp", "udp"],
        "action": "proxy",
        "proxyServer": "remote"
      }
    ]
  },
  "proxyUnavailableAction": "block",
  "processingFailureAction": "block"
}
