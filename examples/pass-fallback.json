{
  "WinForward": {
    "Socks5Servers": [
      {
        "Name": "remote",
        "Host": "proxy.example.com",
        "Port": 1080
      }
    ],
    "Host": {
      "FallbackAction": "pass",
      "Rules": [
        {
          "Process": ["browser.exe"],
          "Action": "proxy",
          "Target": "remote"
        }
      ]
    },
    "ProxyUnavailableAction": "block",
    "ProcessingFailureAction": "block"
  }
}
