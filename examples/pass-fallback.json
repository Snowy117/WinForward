{
  "socks5Servers": [
    {
      "name": "remote",
      "host": "proxy.example.com",
      "port": 1080
    }
  ],
  "rules": [
    {
      "process": ["browser.exe"],
      "action": "proxy",
      "proxyServer": "remote"
    }
  ],
  "fallbackAction": "pass",
  "proxyUnavailableAction": "block",
  "processingFailureAction": "block"
}
