{
  "socks5Servers": [
    {
      "name": "remote",
      "host": "proxy.example.com",
      "port": 1080
    }
  ],
  "host": {
    "fallbackAction": "pass",
    "rules": [
      {
        "protocol": ["udp"],
        "remotePort": ["53"],
        "action": "proxy",
        "proxyServer": "remote"
      },
      {
        "protocol": ["tcp"],
        "remotePort": ["53"],
        "action": "block"
      }
    ]
  },
  "proxyUnavailableAction": "block",
  "processingFailureAction": "block"
}
