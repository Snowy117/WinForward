{
  "socks5Servers": [
    {
      "name": "remote",
      "host": "proxy.example.com",
      "port": 1080
    }
  ],
  "host": {
    "fallbackAction": "block",
    "rules": [
      {
        "process": ["browser.exe"],
        "action": "proxy",
        "proxyServer": "remote"
      }
    ]
  },
  "proxyUnavailableAction": "block",
  "processingFailureAction": "block"
}
